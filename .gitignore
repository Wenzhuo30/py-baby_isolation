# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# uv / build caches
.uv-cache/
.uv/
pytest_cache/
.pytest_cache/

# matplotlib font cache created by the head-less IR-SIM benchmark
.mplconfig/

# Local secrets / environment - never commit the API key
.env

# Orchestration log is regenerated by `python main.py`
trace.log

# Text extracted from the course PDFs by _pdf_tool.py (regenerable, and the
# course material itself should not be turned into derived files in the repo)
_pdf_*.txt
_spec_*.txt

# Scratch copies made while experimenting (main.py / the test agents regenerate
# generated/navigation_logic.py at any time)
*.bak

# Duplicate downloads such as "brief (1).txt".  Keep the "SCSE '26 - Project
# Instructions - ..." briefs themselves tracked: they are the assignment
# specifications this code is checked against.
* ([0-9]).txt
* ([0-9]).[a-z][a-z][a-z]
SCSE*\([0-9]\).pdf

# OS files
.DS_Store
Thumbs.db
