# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# uv / build caches
.uv-cache/
.uv/
pytest_cache/
.pytest_cache/

# matplotlib font cache created by the head-less IR-SIM benchmark
.mplconfig/

# PNG snapshots of the head-less IR-SIM visual run (regenerate with
# `python tools/run_visual.py`; the interactive `./run_visual.sh <world>` opens
# the window directly and writes no files)
visuals/

# Local secrets / environment - never commit the API key
.env

# Orchestration log is regenerated by `python main.py`
trace.log

# Text extracted from the course PDFs by tools/_pdf_tool.py (regenerable, and the
# course material itself should not be turned into derived files in the repo)
_pdf_*.txt
_spec_*.txt
scratch/_pdf_out/

# Scratch copies made while experimenting (main.py / the test agents regenerate
# generated/navigation_logic.py at any time)
*.bak

# Duplicate downloads such as "brief (1).txt" are regenerable copies, so they
# are ignored - but the four "SCSE ... - Project Instructions - ..." PDFs ARE
# the assignment specifications this code is checked against, so they are
# re-included below.  A negation rule only wins when it comes after the rule it
# overrides, which is why the whitelist is the last block of this file.
* ([0-9]).txt
* ([0-9]).[a-z][a-z][a-z]
SCSE*\([0-9]\).pdf

# --- assignment specifications: always tracked -----------------------------
# Without these, "git add ." silently drops three of the four instruction PDFs
# even though the comments above say they must stay in the repository.
!SCSE*.pdf

# OS files
.DS_Store
Thumbs.db
