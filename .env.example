# ===========================================================================
# LLM backend configuration
# ===========================================================================
# The project targets Qwen on Alibaba Cloud DashScope. With this file absent (or
# the two LLM_* variables unset) the agents talk to DashScope exactly as before.
#
# Copy this file to ".env" and paste your DashScope (Qwen) API key.
# Get a key at: https://bailian.console.aliyun.com/ -> API-KEY
DASHSCOPE_API_KEY=sk-your-key-here

# Optional: override the model (defaults to qwen-plus)
# QWEN_MODEL=qwen-plus

# ---------------------------------------------------------------------------
# Optional: use a LOCAL OpenAI-compatible server instead of DashScope
# ---------------------------------------------------------------------------
# The "Ollama and Qwen installation" practice sheet runs qwen3:8b on your own
# machine. Uncommenting the two lines below points the agents at it, so no
# DashScope key is needed at all.
#
# CAVEAT: this is a development convenience. The project instructions describe
# Qwen on DashScope and require the requirements JSON to come from Qwen, so
# confirm with your instructor before submitting a run that used a local model.
#
# Expect roughly a minute per agent call on CPU (the model "thinks" first), i.e.
# a full pipeline takes 10-25 minutes instead of a few seconds.
#
# Verify the backend BEFORE a scored run:  python check_llm.py
#
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# QWEN_MODEL=qwen3:8b
#
# Timeout per request. Defaults to 60s on DashScope and 1800s for a local
# backend, because qwen3:8b needs ~20 minutes for the TestAgent prompt (it
# "thinks" first). Raise it if a local run times out.
# LLM_TIMEOUT=1800
